{
  "name": "auto-drawing",
  "version": "0.1.0",
  "description": "Universal AI Game Video Engine — modular monolith (Epic 1: Foundation)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "game": "bin/game.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "products:list": "node bin/game.js products list",
    "products:generate": "node scripts/generate-products.mjs",
    "assets:generate": "node scripts/generate-assets.mjs",
    "verify": "npm run build && npm run lint && npm test"
  },
  "dependencies": {
    "@types/seedrandom": "^3.0.8",
    "seedrandom": "^3.0.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2"
  }
}
